# --- Dependencies ---
node_modules/
.pnp
.pnp.*

# --- Next.js build output ---
.next/
out/
dist/
build/

# --- Vercel ---
.vercel/

# --- Environment (never commit secrets or local overrides) ---
.env
.env.*
!.env.example

# --- TypeScript / build caches ---
*.tsbuildinfo
next-env.d.ts

# --- Lint / format caches ---
.eslintcache
*.eslintcache

# --- Test artifacts ---
coverage/
.vitest/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Vendored Chromium native libraries (see scripts/setup-chromium-deps.sh)
.playwright-deps/

# --- Storybook ---
storybook-static/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# --- Misc generated files ---
*.pid
*.seed
*.pid.lock
*.pem

.pi-subagents/
# Devloop chain registry — local-only bookkeeping of stacked devloop runs
.pi/devloop-stack.json
.pi/devloop-stack.json.lock
# Devloop session/plan artifacts — ephemeral per-run state, never commit
.pi/devloop-sessions/
