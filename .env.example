# Development-only server secrets.
# Never commit real values, child data, generated stories, or exported files.
# Copy to `.env.local` (gitignored) and fill in development values locally.

# OpenRouter provider — read ONLY by the server-only provider adapter
# (src/features/story-generation/server/openrouter-story-generation-provider.ts).
OPENROUTER_API_KEY=replace-with-development-key
OPENROUTER_TEXT_MODEL=replace-with-approved-structured-output-model
OPENROUTER_IMAGE_MODEL=replace-with-approved-image-model
OPENROUTER_MODERATION_MODEL=replace-with-approved-moderation-model

# Provider selector for the generation runtime (default `openrouter`).
# Set `STORIES_PROVIDER=fake` only for deterministic e2e/visual/dev runs — it
# uses a fixed in-repo provider that never calls a live AI service. When `fake`
# is used, the OpenRouter_* credentials above are not required.
# STORIES_PROVIDER=openrouter

# AI narration (natural TTS voice) — read ONLY by the server-only TTS adapters
# (src/features/story-read-aloud/server/). Server-only vars, never on the
# client.
#
# When TRUE, the anonymous scene text is sent behind the server boundary to the
# configured neural TTS model and returned as transient audio (no fallback to
# the system Web Speech voice on failure). When FALSE (default), narration uses
# the browser's native speechSynthesis directly. No user-facing toggle.
# AI_NARRATION_ENABLED=false
#
# TTS model identifier (server-only, cost-vs-naturalness profile is configurable
# per environment). Reference: Kokoro 82M via OpenRouter (pt-BR voices), billed
# per character. Default assumed to be OpenRouter.
# OPENROUTER_TTS_MODEL=replace-with-tts-model-identifier
