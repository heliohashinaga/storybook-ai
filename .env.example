# ---------------------------
# storybook-ai — local environment
# ---------------------------
# Copy to `.env.local` (gitignored) and fill in.

# Provider keys
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENCODE_GO_API_KEY=replace-with-opencode-go-key

# Set only to `fake` for deterministic e2e/visual/dev runs (uses a fixed local
# provider, no real AI). Leave unset in production.
STORIES_TEST_MODE=fake

# In `fake` mode, artificial per-step latency in ms that keeps the loading
# screen visible during a deterministic run (default: 1000). 
# Set to 0 for the fastest possible offline runs.
# STORY_FAKE_STEP_DELAY_MS=1000

# Copy the block below and set real models (the first segment = provider,
# `opencode-go` or `openrouter`; unprefixed models are rejected at boot).
#   PLANNER_MODEL=opencode-go/deepseek-v4-flash
#   WRITER_MODEL=opencode-go/deepseek-v4-flash
#   MODERATOR_MODEL=opencode-go/deepseek-v4-flash
#   ILLUSTRATOR_MODEL=openrouter/openai/gpt-5-image-mini
#   READER_MODEL=openrouter/fish-audio/s2.1-pro-free:free
PLANNER_MODEL=replace-with-text-model
WRITER_MODEL=replace-with-text-model
MODERATOR_MODEL=replace-with-moderation-model
ILLUSTRATOR_MODEL=replace-with-image-model
READER_MODEL=replace-with-tts-model-identifier

# AI narration (TTS). Uncomment to enable the neural voice (uses the TTS
# model identifier set in READER_MODEL above). Default: false (uses native
# browser speechSynthesis).
# AI_NARRATION_ENABLED=false

# Per-locale voice ids for Kokoro-style TTS models (ignored by models that
# reject the `voice` field, e.g. Fish-Audio). Optional; sensible defaults
# are used when unset.
# READER_VOICE_PT_BR=af_heart
# READER_VOICE_EN=am_michael

# Rate limiting for story generation (per IP), 10 requests / 60s by default.
# Responses: 429 `rate_limited` when exceeded, with Retry-After.
# Raise for long CI/browser runs against one shared server/IP.
# STORY_RATE_LIMIT_MAX_REQUESTS=10
# STORY_RATE_LIMIT_WINDOW_MS=60000

# Rate limiting for AI narration (TTS) synthesis, per IP, 30 requests / 60s by default.
# Responses: 429 `narration_rate_limited` when exceeded, with Retry-After.
# TTS_RATE_LIMIT_MAX_REQUESTS=30
# TTS_RATE_LIMIT_WINDOW_MS=60000

# `MODEL_TIMEOUT_MS`: timeout in ms for a single model/provider request. Default: 60000.
# MODEL_TIMEOUT_MS=60000

# `MODEL_MAX_ATTEMPTS`: total attempts for a single model request against a
# transient failure, including the first call. Default: 1 (a single attempt, no retry).
# MODEL_MAX_ATTEMPTS=1
#
# `PIPELINE_TIMEOUT_MS`: end-to-end latency budget in ms for the whole pipeline
# (Planner -> Writer -> Moderator -> Illustrator). Default: 120000.
# PIPELINE_TIMEOUT_MS=120000

# ---------------------------
# Playground gatekeeper (porteiro) — OPTIONAL (ADR 0015).
# ---------------------------
# A single shared password gates the real-LLM playground (/form, /reader).
# Both vars are server-only (never exposed to the client, no NEXT_PUBLIC_*).
# With either unset (or a malformed hash), the app runs demo-only: /demo works
# cookie-less, / shows the demo-only panel and POST /api/gate/login always 401.
#   GATEKEEPER_SECRET: JWT signing secret (HS256), minimum 32 chars.
#     openssl rand -hex 32
#   PLAYGROUND_PASSWORD_HASH: scrypt derivation of the password, shape
#   `scrypt:<32 hex salt>:<64 hex key>`. Generate it (never hash the password
#   with a fast digest like SHA-256 — that value is rejected):
#     PLAYGROUND_PASSWORD='your-password' pnpm gate:hash
#   PowerShell: $env:PLAYGROUND_PASSWORD='your-password'; pnpm gate:hash
#   Add `-- --write` to update this line in .env.local in place (only that line
#   is rewritten; other vars, line endings and file permissions are kept).
#   The salt is random per run, so any generated line is valid; paste it whole.
#   Do NOT use `$` as the separator: Next expands `$` in .env values, so the
#   value would load as plain `scrypt` and the gate would stay closed.
# GATEKEEPER_SECRET=replace-with-32-plus-char-secret
# PLAYGROUND_PASSWORD_HASH=scrypt:<salt-hex-32>:<key-hex-64>

# ---------------------------
# Cloudflare Turnstile (demo anti-bot) — OPTIONAL.
# ---------------------------
# Protects the anonymous /demo generation path against bots. Both keys are
# optional: absent keys disable the feature (the demo behaves as before).
# Site key is publishable (exposed to the browser); secret stays server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
