# ---------------------------
# storybook-ai — local environment
# ---------------------------
# Copy to `.env.local` (gitignored) and fill in.

# Provider keys
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENCODE_GO_API_KEY=replace-with-opencode-go-key

# Set only to `fake` for deterministic e2e/visual/dev runs (uses a fixed local
# provider, no real AI). Leave unset in production.
# STORIES_TEST_MODE=fake

# Copy the block below and set real models (the first segment = provider):
#   TEXT_MODEL=opencode-go/qwen/qwen3.7-flash
#   IMAGE_MODEL=openrouter/openai/gpt-5-image-mini
TEXT_MODEL=replace-with-text-model
IMAGE_MODEL=replace-with-image-model
MODERATION_MODEL=replace-with-moderation-model
TTS_MODEL=replace-with-tts-model-identifier

# AI narration (TTS). Uncomment to enable the neural voice (requires the TTS
# model below). Default: false (uses native browser speechSynthesis).
# AI_NARRATION_ENABLED=false

# Anonymous rate limiting for story generation (per IP), 10 requests / 60s by
# default. The bucket key is a SHA-256 hash of the IP with a rotating per-boot
# salt (createPseudoAnonymousKey) — the raw IP is never stored in clear and is
# never sent to any provider. This avoids retaining an IP as personal data and
# keeps the product anonymous by design. 429 `rate_limited` when exceeded.
# Raise for long CI/browser runs against one shared server/IP.
# STORY_RATE_LIMIT_MAX_REQUESTS=10
# STORY_RATE_LIMIT_WINDOW_MS=60000

# Anonymous rate limiting for AI narration (TTS) synthesis, per IP, 30 requests
# / 60s by default. Same salted-hash bucketing as story generation (raw IP never
# stored/sent). More generous than story generation because navigating and
# narrating several scenes back-to-back is normal reading flow. 429
# `narration_rate_limited` when exceeded.
# TTS_RATE_LIMIT_MAX_REQUESTS=30
# TTS_RATE_LIMIT_WINDOW_MS=60000
