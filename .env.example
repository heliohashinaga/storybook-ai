# Development-only server secrets.
# Never commit real values, child data, generated stories, or exported files.
# Copy to `.env.local` (gitignored) and fill in development values locally.

# OpenAI provider — read ONLY by the server-only provider adapter
# (src/features/story-generation/server/openai-story-generation-provider.ts).
OPENAI_API_KEY=replace-with-development-key
OPENAI_TEXT_MODEL=replace-with-approved-structured-output-model
OPENAI_IMAGE_MODEL=replace-with-approved-image-model
