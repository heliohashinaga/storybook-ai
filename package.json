{
  "name": "storybook-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:test": "start-server-and-test \"storybook dev -p 6006\" http://127.0.0.1:6006 \"sh scripts/run-with-chromium.sh test-storybook --url http://127.0.0.1:6006 --maxWorkers=1 --testTimeout=60000\"",
    "pretest:e2e": "pnpm build",
    "test:e2e": "sh scripts/run-with-chromium.sh playwright test",
    "pretest:visual": "pnpm build",
    "test:visual": "sh scripts/run-with-chromium.sh playwright test tests/visual",
    "pretest:performance": "pnpm build",
    "test:performance": "sh scripts/run-with-chromium.sh playwright test tests/performance",
    "postinstall": "sh scripts/install-hooks.sh",
    "build": "next build",
    "analyze": "ANALYZE=true next build --webpack",
    "analyze:tp": "next build --experimental-analyze",
    "test:limited": "vitest run --pool threads --maxWorkers 2",
    "test:coverage:limited": "vitest run --coverage --pool threads --maxWorkers 2",
    "gate:hash": "tsx scripts/hash-playground-password.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "openai": "^7.39.0",
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/nextjs": "10.5.10",
    "@storybook/react": "10.6.3",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-playwright": "^2.2.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "start-server-and-test": "^3.0.13",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
